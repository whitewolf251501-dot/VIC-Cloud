# ==============================================================================
# VIC-Cloud Environment Configuration Template
# DO NOT ADD REAL SECRETS OR KEYS TO THIS FILE
# Copy this file to .env.local for local development
# ==============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# AI Model Provider Credentials (Configured securely in Cloud Vault / Desktop)
GEMINI_API_KEY=your-gemini-api-key-placeholder
GROQ_API_KEY=your-groq-api-key-placeholder

# Vercel Deployment & Security
VIC_WEB_SECRET=your-secure-random-token-for-web-session
VIC_BRIDGE_API_KEY=your-secure-device-bridge-token

# Device & Bridge Settings
VIC_DESKTOP_DEVICE_ID=desktop-windows-primary
VIC_ANDROID_DEVICE_ID=android-redmi-primary
VIC_ENVIRONMENT=development
