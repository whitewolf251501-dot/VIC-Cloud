<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VIC" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vic_cyan_primary</item>
        <item name="colorSecondary">@color/vic_purple_accent</item>
        <item name="android:statusBarColor">@color/vic_background_dark</item>
        <item name="android:windowBackground">@color/vic_background_dark</item>
        <item name="android:textColorPrimary">@color/vic_text_primary</item>
    </style>

    <!-- Translucent Overlay Theme for Assistant Invocations -->
    <style name="Theme.VIC.AssistOverlay" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@color/vic_overlay_scrim</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
    </style>
</resources>
